# Copy to an ignored .env file and generate new values for every environment.
# Never paste a seed phrase or reuse a merchant/deployer wallet private key.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
EXPOSE_API_DOCS=true

POSTGRES_DB=giwapay
POSTGRES_USER=giwapay
POSTGRES_PASSWORD=
DATABASE_URL=

ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TRUSTED_PROXY_CIDRS=
WEB_BASE_URL=http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:3001
SESSION_SECRET=
API_KEY_PEPPER=
# Base64 encoding of exactly 32 random bytes.
WEBHOOK_ENCRYPTION_KEY=
# Required for a production cookie shared across the configured web/API origin.
# SESSION_COOKIE_DOMAIN=
SESSION_TTL_SECONDS=43200
SIWE_NONCE_TTL_SECONDS=300

GIWA_CHAIN_ID=91342
GIWA_RPC_URL=https://sepolia-rpc.giwa.io
GIWA_RPC_FALLBACK_URLS=
CHAIN_EXPLORER_URL=https://sepolia-explorer.giwa.io
RPC_TIMEOUT_MS=10000
RPC_RETRY_COUNT=3
CHAIN_READ_CACHE_TTL_MS=2000
ROUTER_CONFIGURATION_CACHE_TTL_MS=300000
QUOTE_RATE_LIMIT_MAX=30
PREPARE_RATE_LIMIT_MAX=20
CHAIN_CONFIRMATIONS=3
CHAIN_START_BLOCK=0
INDEXER_BATCH_SIZE=250
INDEXER_POLL_INTERVAL_MS=2000
REORG_LOOKBACK_BLOCKS=1000

# Populate from a verified deployment manifest. Do not invent addresses.
# PAYMENT_ROUTER_ADDRESS=
# MERCHANT_REGISTRY_ADDRESS=
# ADAPTER_REGISTRY_ADDRESS=
# Development/local demo only. Production rejects extractable shared keys.
# PAYMENT_INTENT_SIGNER_PRIVATE_KEY=
# Production: one non-exportable secp256k1 AWS KMS key per merchant.
# AWS_REGION=ap-northeast-2
# AWS_KMS_ENDPOINT=
# AWS_KMS_READINESS_KEY_ID=alias/giwapay-readiness
# AWS_KMS_TIMEOUT_MS=3000
# PAYMENT_INTENT_SIGNER_KEYS_JSON=[{"merchant":"0x...","provider":"aws-kms","keyId":"alias/giwapay-merchant-...","address":"0x..."}]
PLATFORM_FEE_BPS=50
ALLOW_TEST_CONTRACTS=false
SUPPORTED_PAYMENT_TOKENS_JSON=[]

WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_POLL_INTERVAL_MS=1000
API_KEY_LAST_USED_WRITE_INTERVAL_MS=300000
RETENTION_POLL_INTERVAL_MS=3600000
AUTH_RETENTION_DAYS=7
WEBHOOK_RETENTION_DAYS=90
RETENTION_BATCH_SIZE=1000

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_GIWA_RPC_URL=https://sepolia-rpc.giwa.io
NEXT_PUBLIC_GIWA_RPC_FALLBACK_URLS=
NEXT_PUBLIC_GIWA_EXPLORER_URL=https://sepolia-explorer.giwa.io
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# NEXT_PUBLIC_ALLOW_TEST_CONTRACTS=false
# NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=
# NEXT_PUBLIC_MERCHANT_REGISTRY_ADDRESS=
# NEXT_PUBLIC_MOCK_KRW_ADDRESS=
# NEXT_PUBLIC_MOCK_USDC_ADDRESS=
# NEXT_PUBLIC_MOCK_ALT_ADDRESS=
# NEXT_PUBLIC_MOCK_TOKEN_FAUCET_ADDRESS=
# Public display metadata and supported settlement pairs. Test-only entries
# must be rejected in production.
# NEXT_PUBLIC_PAYMENT_TOKENS_JSON=[]

# Optional error reporting. Keep DSNs and release credentials outside Git.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=
