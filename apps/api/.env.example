# Local/testnet demo only. Generate independent random values directly into a
# permission-restricted secret store; never print or commit them.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
EXPOSE_API_DOCS=true
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
SESSION_SECRET=
API_KEY_PEPPER=
# Must decode to exactly 32 bytes.
WEBHOOK_ENCRYPTION_KEY=
TRUSTED_PROXY_CIDRS=

GIWA_CHAIN_ID=91342
GIWA_RPC_URL=https://sepolia-rpc.giwa.io
# Prefer independent dedicated providers. Comma-separated.
GIWA_RPC_FALLBACK_URLS=
# Set blank for local Anvil, which has no transaction explorer.
CHAIN_EXPLORER_URL=https://sepolia-explorer.giwa.io
RPC_TIMEOUT_MS=10000
RPC_RETRY_COUNT=3
CHAIN_READ_CACHE_TTL_MS=2000
ROUTER_CONFIGURATION_CACHE_TTL_MS=300000
QUOTE_RATE_LIMIT_MAX=30
PREPARE_RATE_LIMIT_MAX=20

# Populate from the local deployment manifest or an opt-in GIWA Sepolia
# deployment. Never insert unofficial production token addresses.
PAYMENT_ROUTER_ADDRESS=
MERCHANT_REGISTRY_ADDRESS=
ADAPTER_REGISTRY_ADDRESS=
# Development/local demo only. Production rejects extractable shared keys.
PAYMENT_INTENT_SIGNER_PRIVATE_KEY=
# Production requires one non-exportable secp256k1 AWS KMS key per merchant.
AWS_REGION=
AWS_KMS_ENDPOINT=
# Dedicated enabled ECC_SECG_P256K1 probe key. Do not reuse a merchant key.
AWS_KMS_READINESS_KEY_ID=
AWS_KMS_TIMEOUT_MS=3000
PAYMENT_INTENT_SIGNER_KEYS_JSON=[]
PLATFORM_FEE_BPS=50

# This central list is intentionally empty until contracts are deployed.
# Example entry keys:
# token, tokenSymbol, tokenName, tokenDecimals, settlementToken, adapter (omit
# for direct), adapterIdentifier, adapterData, maxInputCap,
# defaultSlippageBps, testOnly.
SUPPORTED_PAYMENT_TOKENS_JSON=[]
# Explicit local/testnet-demo switch. Keep false for customer deployments.
ALLOW_TEST_CONTRACTS=false

CHAIN_START_BLOCK=0
CHAIN_CONFIRMATIONS=3
INDEXER_BATCH_SIZE=250
INDEXER_POLL_INTERVAL_MS=2000
REORG_LOOKBACK_BLOCKS=1000

SESSION_TTL_SECONDS=43200
SIWE_NONCE_TTL_SECONDS=300
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_POLL_INTERVAL_MS=1000
API_KEY_LAST_USED_WRITE_INTERVAL_MS=300000
RETENTION_POLL_INTERVAL_MS=3600000
AUTH_RETENTION_DAYS=7
WEBHOOK_RETENTION_DAYS=90
RETENTION_BATCH_SIZE=1000

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
