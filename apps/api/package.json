{
  "name": "@giwapay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev:indexer": "tsx watch src/indexer.ts",
    "dev:webhooks": "tsx watch src/webhook-worker.ts",
    "start": "node dist/server.js",
    "start:server": "node dist/server.js",
    "start:indexer": "node dist/indexer.js",
    "start:webhooks": "node dist/webhook-worker.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:anvil": "tsc -p tsconfig.anvil.json --noEmit && vitest run --config vitest.anvil.config.ts",
    "test:integration": "vitest run src/auth.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.0",
    "@giwapay/chains": "workspace:*",
    "@giwapay/db": "workspace:*",
    "@sentry/node": "10.68.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "fastify-type-provider-zod": "7.0.0",
    "ipaddr.js": "2.4.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "siwe": "3.0.0",
    "undici": "8.9.0",
    "viem": "2.55.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
