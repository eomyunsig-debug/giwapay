FROM node:24.18.0-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN npm install --global pnpm@11.9.0

ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GIWA_RPC_URL
ARG NEXT_PUBLIC_GIWA_RPC_FALLBACK_URLS
ARG NEXT_PUBLIC_GIWA_EXPLORER_URL
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ARG NEXT_PUBLIC_ALLOW_TEST_CONTRACTS
ARG NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS
ARG NEXT_PUBLIC_MERCHANT_REGISTRY_ADDRESS
ARG NEXT_PUBLIC_MOCK_KRW_ADDRESS
ARG NEXT_PUBLIC_MOCK_USDC_ADDRESS
ARG NEXT_PUBLIC_MOCK_ALT_ADDRESS
ARG NEXT_PUBLIC_MOCK_TOKEN_FAUCET_ADDRESS
ARG NEXT_PUBLIC_PAYMENT_TOKENS_JSON

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_GIWA_RPC_URL=$NEXT_PUBLIC_GIWA_RPC_URL
ENV NEXT_PUBLIC_GIWA_RPC_FALLBACK_URLS=$NEXT_PUBLIC_GIWA_RPC_FALLBACK_URLS
ENV NEXT_PUBLIC_GIWA_EXPLORER_URL=$NEXT_PUBLIC_GIWA_EXPLORER_URL
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV NEXT_PUBLIC_ALLOW_TEST_CONTRACTS=$NEXT_PUBLIC_ALLOW_TEST_CONTRACTS
ENV NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=$NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS
ENV NEXT_PUBLIC_MERCHANT_REGISTRY_ADDRESS=$NEXT_PUBLIC_MERCHANT_REGISTRY_ADDRESS
ENV NEXT_PUBLIC_MOCK_KRW_ADDRESS=$NEXT_PUBLIC_MOCK_KRW_ADDRESS
ENV NEXT_PUBLIC_MOCK_USDC_ADDRESS=$NEXT_PUBLIC_MOCK_USDC_ADDRESS
ENV NEXT_PUBLIC_MOCK_ALT_ADDRESS=$NEXT_PUBLIC_MOCK_ALT_ADDRESS
ENV NEXT_PUBLIC_MOCK_TOKEN_FAUCET_ADDRESS=$NEXT_PUBLIC_MOCK_TOKEN_FAUCET_ADDRESS
ENV NEXT_PUBLIC_PAYMENT_TOKENS_JSON=$NEXT_PUBLIC_PAYMENT_TOKENS_JSON

WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @giwapay/web... build
RUN pnpm --filter @giwapay/web deploy --prod --legacy /opt/giwapay-web \
  && cp -R apps/web/.next /opt/giwapay-web/.next

FROM node:24.18.0-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app
COPY --chown=node:node --from=build /opt/giwapay-web /app

USER node
EXPOSE 3000
CMD ["node_modules/.bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
